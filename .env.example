# Simon local server
SIMON_HOST=127.0.0.1
SIMON_PORT=4310
SIMON_DATA_DIR=./data
SIMON_LOG_LEVEL=info
# pi for the real restricted runtime; fake for deterministic UI development
SIMON_RUNTIME=pi

# Engineering integration remains synthetic unless explicitly enabled.
# SIMON_ENGINEERING_MODE=tia-readonly
# SIMON_ENGINEERING_CONNECTOR=tia-v20
# The TIA V20 worker is incorporated and built under Simon/mcp/worker/tia/v20.
# Optional trusted host selection when multiple TIA Portal processes are running:
# SIMON_TIA_PROCESS_ID=1600
# SIMON_TIA_V20_TOOL_TIMEOUT_MS=30000
# SIMON_TIA_V20_ARTIFACT_ROOT=./data/mcp-artifacts

# Pi uses its supported local settings and credential stores.
# Do not place real provider keys in this repository.
# Optional provider variables may be supplied locally when required by Pi:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
